# Backend (copy to backend/.env or set in your host / Docker)
# APP_ENV=production enforces strong JWT_SECRET_KEY and ENCRYPTION_KEY, and disables open registration by default.
APP_ENV=development

JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=

# Optional: allow public signup when APP_ENV=production (default off if unset in production)
# REGISTRATION_ENABLED=true

# Optional seed script only (never commit real API keys)
# SEED_OPENAI_KEY=
