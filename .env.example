
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
ENCRYPTION_KEY=replace-with-a-fernet-key
CORS_ORIGINS=http://localhost:3000
SERVER_BASE_URL=http://localhost:8000
UPLOADS_DIR=/app/uploads
FRONTEND_URL=http://localhost:3000

# Optional fallback Pinterest credentials; website overrides can be saved in the app.
# Backend only. Never use NEXT_PUBLIC_ for secrets.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://bohssini.com/pinterest/callback

# Facebook Pages OAuth. These can also be configured per Facebook project.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0
# Optional Netscape cookie file for public Reels that Facebook gates behind login.
# Keep it in the uploads volume; never commit the cookie file.
FACEBOOK_COOKIES_FILE=/app/uploads/facebook/cookies.txt
# Keep videos briefly after the last Page publication so Meta can finish ingestion.
# Use 0 for immediate cleanup. The default is 1 hour.
FACEBOOK_VIDEO_RETENTION_HOURS=1
